# Environment variables of Ollama Multi Manager. Copy this file to .env.dev for `yarn start:dev` (read by scripts/start-dev.js).
# A variable already set in the shell wins over this file. Lines starting with # are comments; a line with no value is unset.

# --- Developer mode (desktop shell) ---
# Developer mode: adds the developer menu (reload, pause updates, inspect). `yarn start:dev` always turns it on, with or without
# this file; set it here only for other ways of starting the app. 1 = on.
OMM_DEV=1
# 1 = serve the design mockup (frontend/mockup) on this PC, independent of developer mode.
OMM_MOCKUP=1
# Port of the mockup server (default 5175).
#OMM_MOCKUP_PORT=5175
# macOS and Windows: 1 = use the system title bar instead of the page's own header.
#OMM_NATIVE_TITLEBAR=1
# 1 = windows do not remember or restore their place and size.
#OMM_NO_WINDOW_STATE=1
# 1 = print what a window reports while it is moved (to track down window placement problems).
#OMM_DEBUG_WINDOW=1

# --- Backend ---
# Path of the Python interpreter that runs the backend (default: backend/.venv).
#OMM_PYTHON=/path/to/python
# 1 = the backend does not look for Ollama's model store at startup (used by the tests).
#OMM_NO_STORE_WARM=1
# Address the web access (guest) server listens on (default 0.0.0.0).
#OMM_EXTERNAL_HOST=127.0.0.1
# Origins allowed to call the API from another address, separated by commas (default http://127.0.0.1:5174,http://localhost:5174).
#OMM_CORS_ORIGINS=http://127.0.0.1:5174

# --- Ollama ---
# Folder of the models that instances use when no model folder is set in the settings (default ~/.ollama/models).
#OLLAMA_MODELS=/path/to/models
