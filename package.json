{
  "name": "ollama-multi-manager",
  "productName": "Ollama Multi Manager",
  "version": "0.1.0",
  "description": "Run and monitor multiple Ollama instances from one desktop app",
  "private": true,
  "main": "electron/main.js",
  "author": "gyuholee-dev",
  "license": "MIT",
  "scripts": {
    "start": "node scripts/start.js",
    "start:dev": "node scripts/start-dev.js",
    "build:backend": "node scripts/build-backend.js",
    "dist:dir": "yarn build:frontend && yarn build:backend && electron-builder --dir",
    "dist": "yarn build:frontend && yarn build:backend && electron-builder",
    "build:frontend": "tsc --noEmit -p frontend && vite build --config frontend/vite.config.mts",
    "build:mockup-css": "node scripts/build-mockup-css.js",
    "typecheck": "tsc --noEmit -p frontend",
    "test:frontend": "vitest run --config frontend/vitest.config.ts"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "~44.10.2",
    "electron-builder": "^26.18.0",
    "sass": "^1.108.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^3"
  },
  "build": {
    "appId": "dev.gyuholee.ollama-multi-manager",
    "productName": "Ollama Multi Manager",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "!electron/assets/make-icons.py"
    ],
    "extraResources": [
      {
        "from": "build/backend/ollama-multi-manager-backend",
        "to": "backend"
      },
      {
        "from": "frontend/dist",
        "to": "frontend"
      }
    ],
    "icon": "electron/assets/icon.png",
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    }
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  }
}
